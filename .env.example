# Non-secret frontend configuration ONLY. Everything here is shipped to the browser.
# Never place gateway secret keys, Cloudinary API secrets, ZeptoMail tokens,
# Laravel APP_KEY or database credentials in this file.

VITE_APP_NAME=Pilotwardrobe
VITE_APP_URL=http://localhost:5173

# Laravel API root, including version prefix.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# mock = in-browser contract fixtures (no backend needed); live = call Laravel.
VITE_API_MODE=mock

# cookie = Laravel Sanctum SPA session (recommended, same-site deployments)
# token  = Bearer access token returned by /auth/login
VITE_AUTH_MODE=cookie
VITE_SANCTUM_CSRF_URL=http://localhost:8000/sanctum/csrf-cookie

# Artificial latency for mock responses (ms).
VITE_MOCK_LATENCY_MS=350

# Public OAuth client id (safe to expose). Leave blank to use backend redirect flow.
VITE_GOOGLE_CLIENT_ID=
