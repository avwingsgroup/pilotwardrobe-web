{
  "name": "pilotwardrobe-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pilotwardrobe — aviation P2P marketplace web client (Vue 3 + TypeScript).",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "build:only": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/ tests/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "images:mock": "python scripts/build-mock-media.py",
    "docs:payloads": "node -e \"process.env.DUMP_OUT='.payloads.json';require('child_process').execSync('npx vitest run tests/unit/contract-payloads.spec.ts',{stdio:'inherit'})\" && python scripts/generate-api-payloads.py .payloads.json docs/api-payloads && node -e \"require('fs').rmSync('.payloads.json')\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.6",
    "@fontsource-variable/space-grotesk": "^5.2.8",
    "@lucide/vue": "^1.60.0",
    "@vueuse/core": "^13.9.0",
    "axios": "^1.12.2",
    "dompurify": "^3.2.6",
    "pinia": "^3.0.4",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.2",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.18.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.36.0",
    "eslint-plugin-vue": "^10.4.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "vite": "^6.3.6",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.12"
  }
}
