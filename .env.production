# Public frontend configuration only; Vite embeds these values in the browser bundle.
VITE_APP_NAME=Pilotwardrobe
VITE_APP_URL=https://pilotwardrobe.com

VITE_API_BASE_URL=https://api.pilotwardrobe.com/api/v1
VITE_API_MODE=live

VITE_AUTH_MODE=cookie
VITE_SANCTUM_CSRF_URL=https://api.pilotwardrobe.com/sanctum/csrf-cookie

VITE_MOCK_LATENCY_MS=0

# Optional public OAuth client ID; blank uses the backend redirect flow.
VITE_GOOGLE_CLIENT_ID=
